          <mxGeometry x="620" y="150" width="78" height="78" as="geometry" />
        </mxCell>

        <!-- Actors -->
        <mxCell id="developer" value="Developer" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=0;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.user;" vertex="1" parent="1">
          <mxGeometry x="45" y="160" width="60" height="60" as="geometry" />
